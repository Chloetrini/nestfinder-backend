# ---- Required ----
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/nestfinder
JWT_SECRET=change-me-to-a-long-random-string

# ---- Server ----
PORT=7200
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Extra allowed frontend origins, comma separated (optional)
CORS_ORIGINS=
LOG_LEVEL=info

# ---- Auth ----
JWT_EXPIRE=7d
EMAIL_VERIFY_TOKEN_EXPIRE=86400000
RESET_TOKEN_EXPIRE=3600000

# ---- Email (Brevo) ----
BREVO_API_KEY=
EMAIL_FROM="NestFinder Pro <no-reply@yourdomain.com>"

# ---- Admin seed (npm run seed:admin) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Cloudinary (property images) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Cache (optional) ----
# Leave empty to use the built-in in-memory cache; set to use Memcachier
MEMCACHIER_SERVERS=
MEMCACHIER_USERNAME=
MEMCACHIER_PASSWORD=
